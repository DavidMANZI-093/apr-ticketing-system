{
	"name": "apr-ticketing-system",
	"version": "1.0.0",
	"description": "A ticketing system for APR events",
	"main": "src/server.ts",
	"scripts": {
		"build": "tsc",
		"start": "node dist/server.js",
		"dev": "nodemon --exec npx tsx src/server.ts",
		"format": "npx @biomejs/biome format --write ./src",
		"db:generate": "prisma generate",
		"db:reset": "prisma migrate reset --force",
		"db:studio": "prisma studio",
		"db:seed": "npx tsx prisma/scripts/db-seed.ts",
		"test:mailer": "npx tsx src/controllers/mailer.ts",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"keywords": [],
	"author": "d3fault",
	"license": "MIT",
	"type": "commonjs",
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.3",
		"@types/jest": "^29.5.12",
		"@types/node": "^24.3.0",
		"@types/supertest": "^6.0.2",
		"jest": "^29.7.0",
		"nodemon": "^3.1.10",
		"prisma": "^6.14.0",
		"supertest": "^6.3.4",
		"ts-jest": "^29.1.2",
		"ts-node": "^10.9.2",
		"tsx": "^4.20.4",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"@prisma/client": "^6.14.0",
		"@trpc/server": "^11.4.4",
		"@types/cors": "^2.8.19",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/nodemailer": "^7.0.1",
		"@types/qrcode": "^1.5.5",
		"@types/uuid": "^10.0.0",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"jsonwebtoken": "^9.0.2",
		"node-cron": "^4.2.1",
		"nodemailer": "^7.0.5",
		"qrcode": "^1.5.4",
		"uuid": "^11.1.0",
		"zod": "^4.0.17"
	}
}
