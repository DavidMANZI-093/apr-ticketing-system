// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DEV
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(255)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([id, active])
}

// Admin model - represents users with administrative roles only
model Admins {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  phrase    String   @db.VarChar(255)
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum TicketState {
  PENDING
  PAID
  USED
  CANCELLED
  REFUNDED
}

enum TicketType {
  SINGLE // Single Ticket (1 Person)
  GROUP // Group Ticket (5 Persons)
  FAMILY // Family Ticket (7 Persons)
  GIFT // Gift Ticket (1 Person)
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Users {
  id         String   @id @default(uuid()) @db.Uuid
  username   String   @unique @db.VarChar(255)
  name       String   @db.VarChar(255)
  email      String   @unique @db.VarChar(255)
  phone      String   @unique @db.VarChar(255)
  subscriber Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  tickets Tickets[]
  orders  Orders[]
}

model Orders {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  user    Users     @relation(fields: [userId], references: [id])
  tickets Tickets[]
}

model Events {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String   @db.VarChar(1020)
  venueId     String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  startsAt    DateTime
  active      Boolean  @default(false)

  teams      Teams[]
  tickets    Tickets[]
  eventSeats EventSeats[]

  venue Venues @relation(fields: [venueId], references: [id])

  @@index([active])
  @@index([startsAt])
  @@index([active, startsAt])
}

model Teams {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(255)
  description String   @db.VarChar(1020)
  logoUrl     String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  eventId String @db.Uuid
  event   Events @relation(fields: [eventId], references: [id])

  tickets Tickets[]
}

model Tickets {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  bearer    Json
  orderId   String?     @db.Uuid
  teamId    String?     @db.Uuid
  eventId   String      @db.Uuid
  seatId    String      @db.Uuid
  type      TicketType
  state     TicketState @default(PENDING)
  expiresAt DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  user  Users      @relation(fields: [userId], references: [id])
  order Orders?    @relation(fields: [orderId], references: [id])
  event Events     @relation(fields: [eventId], references: [id])
  team  Teams?     @relation(fields: [teamId], references: [id])
  seat  EventSeats @relation(fields: [seatId], references: [id])

  @@unique([seatId, eventId]) // prevent double booking
  @@index([eventId])
  @@index([state])
  @@index([expiresAt])
  @@index([eventId, state])
}

model EventSeats {
  id          String  @id @default(uuid()) @db.Uuid
  eventId     String  @db.Uuid
  seatId      String  @db.Uuid
  category    String  @db.VarChar(255)
  price       Float
  isAvailable Boolean @default(true)

  tickets   Tickets[]
  event     Events    @relation(fields: [eventId], references: [id])
  seat      Seats     @relation(fields: [seatId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([eventId, seatId])
  @@index([eventId, seatId])
}

model Seats {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @db.Uuid
  label     String   @db.VarChar(255)
  sectionId String   @db.Uuid
  row       Int
  number    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([venueId, sectionId, row, number])
  @@index([venueId, sectionId, row, number])

  eventSeats EventSeats[]
  venue      Venues       @relation(fields: [venueId], references: [id])
  section    SeatSections @relation(fields: [sectionId], references: [id])
}

model SeatSections {
  id          String   @id @default(uuid()) @db.Uuid
  venueId     String   @db.Uuid
  name        String   @db.VarChar(255)
  svgPathData String   @db.VarChar(1024)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  seats Seats[]
  venue Venues  @relation(fields: [venueId], references: [id])

  @@unique([venueId, name])
  @@index([venueId, name])
}

model Venues {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(10) // more flexible than single char
  description String   @db.VarChar(1020)
  location    String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  events   Events[]
  seats    Seats[]
  sections SeatSections[]
}
